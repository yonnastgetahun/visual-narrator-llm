# Visual Narrator — App Box environment template
# Copy to .env and fill in values. Never commit .env.

# LLM inference (cli/vn/ad.py)
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Gap detection
DEEPGRAM_API_KEY=

# TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ADAM=          # optional — falls back to hardcoded default

# Storage (main.py defaults: us-east-1 / vnpoverview-uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_UPLOAD_BUCKET=vnpoverview-uploads

# YouTube download sidecar — points to cobalt container on Docker vn network
COBALT_API_URL=http://cobalt:9000

# Server port — matches Dockerfile CMD default
PORT=8000

# --- Adult demo (backlog — do not set on App Box Phase 1) ---
# REPLICATE_API_KEY=
# ADULT_DEMO_SHARED_KEY=
# ADULT_DEMO_VOICE_ID=
